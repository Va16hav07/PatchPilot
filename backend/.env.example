MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=thali
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=
# true when served over HTTPS
COOKIE_SECURE=false

# Optional shared Gemini key (users can also use their own key, stored only on their device)
GEMINI_API_KEY=
